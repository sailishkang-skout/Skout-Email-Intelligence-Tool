import {
  GeneratedEmailCandidate
} from "./emailPermutationEngine.js";

import type {
  GeneratedEmailCandidate
} from "./emailPermutationEngine.js";

/*
==================================================
PATTERN RANKER
==================================================

Responsibilities:

1. Rank generated email candidates.
2. Read persistent pattern history.
3. Prefer patterns with proven historical success.
4. Penalize patterns with historical failures.
5. Return transparent ranking reasons.
6. Never write pattern history.

Learning happens elsewhere:

Email Verification
      ↓
Pattern Observation
      ↓
Pattern History
      ↓
Pattern Ranker
==================================================
*/

/*
==================================================
TYPES
==================================================
*/

export interface RankedEmailCandidate {

  email: string;

  pattern: string;

  originalRank: number;

  finalScore: number;

  decision:
    | "STRONG"
    | "GOOD"
    | "UNKNOWN"
    | "WEAK"
    | "REJECT";

  confidence: number;

  attempts: number;

  successes: number;

  failures: number;

  historicalSuccessRate: number;

  reasons: string[];

}

export interface RankedEmailResult {

  candidates: RankedEmailCandidate[];

  recommended:
    RankedEmailCandidate | null;

}

/*
==================================================
CONFIGURATION
==================================================
*/

/*
Base score assigned according to the original
permutation order.

The permutation engine already produces candidates
in an intentional order.

History modifies that score.
*/

const BASE_SCORE_STEP = 10;

/*
Maximum historical bonus.

A proven pattern can substantially improve its
position, but history should not completely destroy
the deterministic baseline.

*/

const MAX_HISTORY_BONUS = 12;

/*
Maximum historical penalty.

*/

const MAX_HISTORY_PENALTY = 10;

/*
Minimum observations before history is treated as
strong evidence.

*/

const STRONG_HISTORY_ATTEMPTS = 3;

/*
==================================================
NORMALIZATION
==================================================
*/

function normalizeDomain(
  domain: string
): string {

  const normalized =
    domain
      .trim()
      .toLowerCase()
      .replace(
        /^https?:\/\//,
        ""
      )
      .replace(
        /^www\./,
        ""
      )
      .split(
        "/"
      )[0];

  if (
    !normalized
  ) {

    throw new Error(
      "Invalid domain"
    );

  }

  return normalized;

}

function normalizePattern(
  pattern: string
): string {

  const normalized =
    pattern
      .trim()
      .toLowerCase();

  if (
    !normalized
  ) {

    throw new Error(
      "Invalid pattern"
    );

  }

  return normalized;

}

/*
==================================================
BASE SCORE
==================================================
*/

function calculateBaseScore(
  originalRank: number
): number {

  if (
    originalRank <= 0
  ) {

    return 0;

  }

  /*
  Rank 1:
    10

  Rank 2:
    9.52

  Rank 3:
    9.05

  etc.

  This keeps your existing style of scoring.
  */

  const score =
    BASE_SCORE_STEP -
    (
      (originalRank - 1) *
      (
        BASE_SCORE_STEP /
        21
      )
    );

  return Math.max(
    0,
    Number(
      score.toFixed(2)
    )
  );

}

/*
==================================================
HISTORICAL SUCCESS RATE
==================================================
*/

function calculateHistoricalSuccessRate(
  successes: number,
  failures: number
): number {

  const attempts =
    successes +
    failures;

  if (
    attempts <= 0
  ) {

    return 0;

  }

  return Number(
    (
      successes /
      attempts *
      100
    ).toFixed(2)
  );

}

/*
==================================================
HISTORY BONUS / PENALTY
==================================================
*/

function calculateHistoryAdjustment(
  attempts: number,
  successes: number,
  failures: number,
  confidence: number
): number {

  if (
    attempts <= 0
  ) {

    return 0;

  }

  const successRate =
    calculateHistoricalSuccessRate(
      successes,
      failures
    );

  /*
  History strength increases gradually.

  1 observation:
    weak

  3 observations:
    meaningful

  5+:
    strong

  This avoids allowing one lucky result to dominate
  the entire ranking.
  */

  const evidenceWeight =
    Math.min(
      1,
      attempts /
      STRONG_HISTORY_ATTEMPTS
    );

  /*
  Success-rate component.

  100% success:
    +MAX_HISTORY_BONUS

  0% success:
    -MAX_HISTORY_PENALTY
  */

  let adjustment =
    (
      successRate /
      100
    ) *
    MAX_HISTORY_BONUS;

  const failureRate =
    failures /
    attempts;

  adjustment -=
    failureRate *
    MAX_HISTORY_PENALTY;

  /*
  Confidence provides a secondary signal.

  Confidence is intentionally weighted less than
  actual success/failure observations.
  */

  const confidenceAdjustment =
    (
      confidence /
      100
    ) *
    2;

  adjustment +=
    confidenceAdjustment;

  adjustment *=
    evidenceWeight;

  return Number(
    adjustment.toFixed(2)
  );

}

/*
==================================================
DECISION
==================================================
*/

function determineDecision(
  attempts: number,
  successes: number,
  failures: number,
  confidence: number
):
  RankedEmailCandidate["decision"] {

  if (
    attempts <= 0
  ) {

    return "UNKNOWN";

  }

  const successRate =
    calculateHistoricalSuccessRate(
      successes,
      failures
    );

  /*
  Strong:

  At least 3 observations and >= 80%
  */

  if (
    attempts >= 3 &&
    successRate >= 80 &&
    confidence >= 75
  ) {

    return "STRONG";

  }

  /*
  Good:

  At least 2 observations and >= 60%
  */

  if (
    attempts >= 2 &&
    successRate >= 60 &&
    confidence >= 60
  ) {

    return "GOOD";

  }

  /*
  Reject:

  Multiple failures and poor success rate.
  */

  if (
    attempts >= 3 &&
    successRate < 30
  ) {

    return "REJECT";

  }

  /*
  Weak:

  Some evidence but not enough to trust strongly.
  */

  if (
    attempts >= 1
  ) {

    return "WEAK";

  }

  return "UNKNOWN";

}

/*
==================================================
REASONS
==================================================
*/

function buildReasons(
  attempts: number,
  successes: number,
  failures: number,
  confidence: number,
  historicalSuccessRate: number,
  adjustment: number
): string[] {

  const reasons:
    string[] = [];

  if (
    attempts === 0
  ) {

    reasons.push(
      "No historical observations for this pattern"
    );

    return reasons;

  }

  reasons.push(
    `${attempts} historical observation(s)`
  );

  if (
    successes > 0
  ) {

    reasons.push(
      `${successes} successful historical observation(s)`
    );

  }

  if (
    failures > 0
  ) {

    reasons.push(
      `${failures} failed historical observation(s)`
    );

  }

  reasons.push(
    `${historicalSuccessRate}% historical success rate`
  );

  reasons.push(
    `${confidence}% historical confidence`
  );

  if (
    adjustment > 0
  ) {

    reasons.push(
      `Historical evidence increased score by ${adjustment}`
    );

  } else if (
    adjustment < 0
  ) {

    reasons.push(
      `Historical evidence reduced score by ${Math.abs(adjustment)}`
    );

  } else {

    reasons.push(
      "Historical evidence produced no score adjustment"
    );

  }

  return reasons;

}

/*
==================================================
RANK ONE CANDIDATE
==================================================
*/

function rankCandidate(
  domain: string,
  candidate: GeneratedEmailCandidate,
  originalRank: number
): RankedEmailCandidate {

  const normalizedDomain =
    normalizeDomain(
      domain
    );

  const normalizedPattern =
    normalizePattern(
      candidate.pattern
    );

  const history =
    getPatternHistory(
      normalizedDomain,
      normalizedPattern
    );

  const attempts =
    history?.attempts ??
    0;

  const successes =
    history?.successes ??
    0;

  const failures =
    history?.failures ??
    0;

  const historicalConfidence =
    history?.confidence ??
    0;

  const historicalSuccessRate =
    calculateHistoricalSuccessRate(
      successes,
      failures
    );

  const baseScore =
    calculateBaseScore(
      originalRank
    );

  const historyAdjustment =
    calculateHistoryAdjustment(
      attempts,
      successes,
      failures,
      historicalConfidence
    );

  const finalScore =
    Number(
      Math.max(
        0,
        baseScore +
        historyAdjustment
      ).toFixed(2)
    );

  const decision =
    determineDecision(
      attempts,
      successes,
      failures,
      historicalConfidence
    );

  const reasons =
    buildReasons(
      attempts,
      successes,
      failures,
      historicalConfidence,
      historicalSuccessRate,
      historyAdjustment
    );

  return {

    email:
      candidate.email,

    pattern:
      normalizedPattern,

    originalRank,

    finalScore,

    decision,

    confidence:
      historicalConfidence,

    attempts,

    successes,

    failures,

    historicalSuccessRate,

    reasons

  };

}

/*
==================================================
PUBLIC:
RANK EMAIL CANDIDATES
==================================================
*/

export function rankEmailCandidates(
  domain: string,
  candidates: GeneratedEmailCandidate[]
): RankedEmailResult {

  const normalizedDomain =
    normalizeDomain(
      domain
    );

  if (
    !Array.isArray(
      candidates
    )
  ) {

    throw new Error(
      "Email candidates must be an array"
    );

  }

  /*
  Remove invalid candidates and duplicate emails.
  */

  const seen =
    new Set<string>();

  const validCandidates =
    candidates.filter(
      (
        candidate
      ) => {

        if (
          !candidate ||
          typeof candidate.email !== "string" ||
          !candidate.email.trim() ||
          typeof candidate.pattern !== "string" ||
          !candidate.pattern.trim()
        ) {

          return false;

        }

        const email =
          candidate.email
            .trim()
            .toLowerCase();

        if (
          seen.has(
            email
          )
        ) {

          return false;

        }

        seen.add(
          email
        );

        return true;

      }
    );

  /*
  Rank using original permutation order.
  */

  const ranked =
    validCandidates.map(
      (
        candidate,
        index
      ) =>
        rankCandidate(
          normalizedDomain,
          candidate,
          index + 1
        )
    );

  /*
  ------------------------------------------------
  SORT
  ------------------------------------------------

  Priority:

  1. STRONG
  2. GOOD
  3. UNKNOWN / WEAK
  4. REJECT

  Within the same class:

  1. final score
  2. historical confidence
  3. success rate
  4. original rank
  */

  const decisionWeight:
    Record<
      RankedEmailCandidate["decision"],
      number
    > = {

    STRONG:
      5,

    GOOD:
      4,

    UNKNOWN:
      3,

    WEAK:
      2,

    REJECT:
      1

  };

  ranked.sort(
    (
      a,
      b
    ) => {

      const decisionDifference =
        decisionWeight[
          b.decision
        ] -
        decisionWeight[
          a.decision
        ];

      if (
        decisionDifference !== 0
      ) {

        return decisionDifference;

      }

      if (
        b.finalScore !==
        a.finalScore
      ) {

        return (
          b.finalScore -
          a.finalScore
        );

      }

      if (
        b.confidence !==
        a.confidence
      ) {

        return (
          b.confidence -
          a.confidence
        );

      }

      if (
        b.historicalSuccessRate !==
        a.historicalSuccessRate
      ) {

        return (
          b.historicalSuccessRate -
          a.historicalSuccessRate
        );

      }

      return (
        a.originalRank -
        b.originalRank
      );

    }
  );

  /*
  Reassign ranking order after sorting is intentionally
  NOT done.

  originalRank represents the permutation engine's
  original ranking and remains immutable.
  */

  /*
  ------------------------------------------------
  RECOMMENDATION
  ------------------------------------------------
  */

  const recommended =
    ranked.find(
      (
        candidate
      ) =>
        candidate.decision ===
          "STRONG" ||
        candidate.decision ===
          "GOOD"
    ) ??
    ranked.find(
      (
        candidate
      ) =>
        candidate.decision !==
        "REJECT"
    ) ??
    ranked[0] ??
    null;

  return {

    candidates:
      ranked,

    recommended

  };

}

/*
==================================================
PATTERN INTELLIGENCE
==================================================

This helper exposes the historical state of one
specific pattern.

Useful for debugging and API responses.
==================================================
*/

export function getPatternIntelligence(
  key: string
): RankedEmailCandidate | null {

  const separator =
    key.indexOf(":");

  if (
    separator <= 0
  ) {

    return null;

  }

  const domain =
    key.slice(
      0,
      separator
    );

  const pattern =
    key.slice(
      separator + 1
    );

  const history =
    getPatternHistory(
      domain,
      pattern
    );

  if (
    !history
  ) {

    return null;

  }

  const historicalSuccessRate =
    calculateHistoricalSuccessRate(
      history.successes,
      history.failures
    );

  const adjustment =
    calculateHistoryAdjustment(
      history.attempts,
      history.successes,
      history.failures,
      history.confidence
    );

  const decision =
    determineDecision(
      history.attempts,
      history.successes,
      history.failures,
      history.confidence
    );

  const reasons =
    buildReasons(
      history.attempts,
      history.successes,
      history.failures,
      history.confidence,
      historicalSuccessRate,
      adjustment
    );

  return {

    email:
      "",

    pattern:
      history.pattern,

    originalRank:
      0,

    finalScore:
      Number(
        adjustment.toFixed(2)
      ),

    decision,

    confidence:
      history.confidence,

    attempts:
      history.attempts,

    successes:
      history.successes,

    failures:
      history.failures,

    historicalSuccessRate,

    reasons

  };

}

/*
==================================================
PUBLIC:
GET PATTERN RANK
==================================================
*/

export function getPatternRank(
  domain: string,
  pattern: string
): RankedEmailCandidate | null {

  return getPatternIntelligence(
    `${domain}:${pattern}`
  );

}