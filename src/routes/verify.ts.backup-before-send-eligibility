import type { FastifyInstance } from "fastify";
import mailchecker from "mailchecker";

import {
  verifyEmail,
} from "../services/emailVerificationOrchestrator.js";

/*
==================================================
REQUEST TYPES
==================================================
*/

interface VerifyRequestBody {
  email?: string;
}

/*
==================================================
MAILCHECKER ADAPTER
==================================================
*/

function isDisposableEmail(
  domain: string
): boolean {
  const checker =
    mailchecker as unknown as {
      isDisposable?: (
        domain: string
      ) => boolean;

      default?: {
        isDisposable?: (
          domain: string
        ) => boolean;
      };
    };

  /*
  Standard CommonJS / ESM API
  */

  if (
    typeof checker.isDisposable ===
    "function"
  ) {
    return checker.isDisposable(
      domain
    );
  }

  /*
  Compatibility with default export
  */

  if (
    typeof checker.default
      ?.isDisposable ===
    "function"
  ) {
    return checker.default.isDisposable(
      domain
    );
  }

  /*
  Fail closed.

  If the installed package does not expose
  the expected API, do NOT classify the
  domain as disposable.
  */

  return false;
}

/*
==================================================
EMAIL VALIDATION
==================================================
*/

function normalizeEmail(
  email: string
): string {
  return email
    .trim()
    .toLowerCase();
}

function extractDomain(
  email: string
): string | null {
  const atIndex =
    email.lastIndexOf("@");

  if (
    atIndex <= 0 ||
    atIndex >=
      email.length - 1
  ) {
    return null;
  }

  const localPart =
    email.slice(
      0,
      atIndex
    );

  const domain =
    email
      .slice(
        atIndex + 1
      )
      .trim()
      .toLowerCase();

  if (
    !localPart ||
    !domain
  ) {
    return null;
  }

  return domain;
}

/*
==================================================
ROUTE
==================================================
*/

export default async function verifyRoutes(
  app: FastifyInstance
): Promise<void> {
  app.post<{
    Body: VerifyRequestBody;
  }>(
    "/verify",
    async (
      request,
      reply
    ) => {
      const email =
        typeof request.body
          ?.email === "string"
          ? normalizeEmail(
              request.body.email
            )
          : "";

      /*
      ============================================
      REQUIRED EMAIL
      ============================================
      */

      if (!email) {
        return reply
          .code(400)
          .send({
            success: false,
            error:
              "email required",
          });
      }

      /*
      ============================================
      DOMAIN
      ============================================
      */

      const domain =
        extractDomain(email);

      if (!domain) {
        return reply
          .code(400)
          .send({
            success: false,
            email,
            error:
              "Invalid email address",
          });
      }

      /*
      ============================================
      DISPOSABLE
      ============================================
      */

      const disposable =
        isDisposableEmail(
          domain
        );

      /*
      ============================================
      VERIFICATION
      ============================================
      */

      try {
        const result =
          await verifyEmail(
            email
          );

        return {
          ...result,

          email,

          domain,

          disposable,
        };
      } catch (error) {
        const message =
          error instanceof Error
            ? error.message
            : "Email verification failed";

        request.log.error(
          {
            err: error,
            email,
            domain,
          },
          "Email verification failed"
        );

        return reply
          .code(500)
          .send({
            success: false,

            email,

            domain,

            disposable,

            error: message,
          });
      }
    }
  );
}